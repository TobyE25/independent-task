# Secrets — never committed. The pseudonymisation key in particular would undo the
# privacy design (DECISIONS.md D5) if it leaked alongside the pseudonymised data.
.env
*.json.key
service-account*.json

# Generated data: the lake, the local warehouse, quarantine, synthetic CSVs.
# Everything under here is reproducible with `make demo`, so none of it belongs in git —
# and it may contain synthetic PII, which is not a reason to relax about committing it.
data/
*.duckdb
*.duckdb.wal
*.parquet

# Python
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
.pytest_cache/
.ruff_cache/

# dbt
dbt/target/
dbt/dbt_packages/
dbt/logs/
.user.yml

# Airflow (local runs only; nothing here is source)
airflow.db
airflow.cfg
airflow-webserver.conf
webserver_config.py
standalone_admin_password.txt
logs/

# OS / editor
.DS_Store
.idea/
.vscode/

# ruff cache
.ruff_cache/
