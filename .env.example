# Copy to .env and fill in.  .env is gitignored and must never be committed.
#
#   cp .env.example .env
#   set -a && . ./.env && set +a
#
# Every variable here is read in exactly one place: pipeline/config.py.

# ---------------------------------------------------------------------------
# Which backing services to use: "local" or "gcp".
# local -> local filesystem + DuckDB. No cloud account, no spend.
# gcp   -> GCS + BigQuery. Requires the GCP_* and BUCKET_* values below.
# ---------------------------------------------------------------------------
TARGET=local
DATA_DIR=data

# ---------------------------------------------------------------------------
# Sports events API (TheSportsDB — see DECISIONS.md D2)
# "3" is TheSportsDB's documented free-tier key. It is a shared public key, so it is a
# reasonable default for a reproducible assessment and the wrong thing for production:
# there, this is a personal key read from Secret Manager, never a committed literal.
# ---------------------------------------------------------------------------
SPORTS_API_KEY=3
# Held below the free tier's ~30 req/min ceiling on purpose. A 429 storm costs the run;
# going slowly costs nothing.
SPORTS_REQUESTS_PER_MINUTE=20

# ---------------------------------------------------------------------------
# Pseudonymisation key (required — there is no default, by design)
#
# This key is what makes customer pseudonyms infeasible to reverse (D5). A default value
# here would mean a misconfigured run emitting predictable, re-identifiable pseudonyms
# that look completely correct — so config.py fails closed instead.
#
# Generate one:   python -c "import secrets; print(secrets.token_urlsafe(32))"
# On GCP this comes from Secret Manager, not from a file.
# ---------------------------------------------------------------------------
PSEUDONYM_HMAC_KEY=
# Stamped on every pseudonymised row so a future key rotation is explainable, rather than
# looking like the entire customer base churned overnight.
PSEUDONYM_KEY_VERSION=v1

# ---------------------------------------------------------------------------
# Google Cloud — required only when TARGET=gcp
# ---------------------------------------------------------------------------
GCP_PROJECT=
# europe-west2 (London): a UK retailer's customer data, kept in-region.
GCP_LOCATION=europe-west2
# Where the ecommerce platform drops its daily CSVs. The pipeline needs read-only on
# this bucket and nothing more.
BUCKET_LANDING=
# Our lakehouse storage: bronze (immutable raw) and silver (Parquet).
BUCKET_LAKE=
BQ_DATASET=pizza_perfect
